# Your Vaaya API key (https://vaaya.ai), with balance. Pays for every backend call.
VAAYA_API_KEY=
# Google OAuth web client. Redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32+ random characters: openssl rand -hex 32
SESSION_SECRET=
# Where the app runs, no trailing slash.
APP_URL=http://localhost:3000
# A Vercel Blob store. Balances, runs and saved results live there.
BLOB_READ_WRITE_TOKEN=

# Card top-ups through your Stripe account. Without them users cannot add funds.
STRIPE_SECRET_KEY=
# Webhook endpoint <APP_URL>/api/stripe/webhook, events checkout.session.completed
# and checkout.session.async_payment_succeeded. Locally: stripe listen --forward-to ...
STRIPE_WEBHOOK_SECRET=

# Optional: your OpenWeb Ninja key (ak_...) for JSearch's direct API.
# Unset, job search goes through Vaaya on VAAYA_API_KEY.
JSEARCH_API_KEY=
# Optional: opens /admin?token=... and the admin API.
ADMIN_TOKEN=
# Optional: credit each new account starts with, in US cents.
START_CREDIT_CENTS=0
# Optional: free resume reads per account per day.
PARSES_PER_DAY=10
# Optional: credit (default) | block | off. One welcome credit per network.
IP_GATE=credit
# Optional: defaults to https://vaaya.ai
VAAYA_URL=

# Optional per-user wallets on Vaaya (see README). Off by default.
VAAYA_CUSTOMERS_ENABLED=false
# Your account's primary, unrestricted Vaaya key. Only used to create and fund wallets.
VAAYA_OWNER_KEY=
CUSTOMER_BUDGET_CENTS=500
CUSTOMER_WELCOME_CENTS=50
